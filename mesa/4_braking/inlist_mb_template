&star_job
   load_saved_model = .true.
   load_model_filename = 'product_rot_t0.mod'

   set_initial_dt = .true.
   years_for_initial_dt = 1d-6

   history_columns_file = 'history_columns.list'
   profile_columns_file = 'profile_columns.list'

   save_model_when_terminate = .true.
   save_model_filename = 'product_mb_TAG_final.mod'

   pgstar_flag = .false.
/

&eos
/

&kap
   Zbase = 0.001
/

&controls
   max_age = 1.2d9
   xa_central_lower_limit_species(1) = 'h1'
   xa_central_lower_limit(1) = 1d-3
   max_model_number = 60000
   max_years_for_timestep = DT_VALUE

   am_D_mix_factor = 0.0333d0
   D_SH_factor = 1
   D_SSI_factor = 1
   D_ES_factor = 1
   D_GSF_factor = 1
   D_DSI_factor = 1
   D_ST_factor = 0
   am_nu_ST_factor = 0

   min_wind = WIND_VALUE
   mdot_omega_power = 0
   max_mdot_redo_cnt = 0
   use_other_adjust_mdot = .true.
   x_ctrl(6) = W0_VALUE
   x_ctrl(7) = 3d0
   x_ctrl(8) = 1d0
   x_ctrl(9) = LAG_VALUE
   x_ctrl(10) = DC_VALUE
   surf_avg_tau_min = 0
   surf_avg_tau = 10

   use_other_torque = .true.
   x_ctrl(1) = BMS_VALUE
   x_ctrl(2) = 1.12d0
   x_ctrl(3) = 0.3d0
   x_ctrl(4) = TDECAY_VALUE
   x_ctrl(5) = 0d0

   steps_before_use_gold_tolerances = 100
   convergence_ignore_equL_residuals = .true.

   log_directory = 'LOGS_mb_TAG'
   history_interval = 1
   profile_interval = 50
   max_num_profile_models = 1000
   terminal_interval = 20
/
